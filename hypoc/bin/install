#!/usr/bin/env bash
# Install hypoc for this user: the `hypoc` command, its runtime services
# (Ollama, Qdrant), and the models the workspace config needs.
# Works on macOS and Linux. Safe to run multiple times; idempotent.

set -euo pipefail

HYPOC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HYPOC_BIN="$HYPOC_DIR/bin/hypoc"
HYPOC_LINK="$HOME/.local/bin/hypoc"
QDRANT_DIR="$HYPOC_DIR/.swarm/qdrant"

# Models the workspace config actually references:
#   llama3.1:8b      default + small model (.hypoc.json)
#   qwen3.5:latest   memory distillation (roster-aligned; phi4 removed, excluded from
#                    the current model roster: reasoning-fine, agentic-weak, no slot)
#   nomic-embed-text memory embeddings
REQUIRED_MODELS=("llama3.1:8b" "qwen3.5:latest" "nomic-embed-text")

say() { echo "[hypoc install] $*"; }

# --- 1. hypoc command on PATH -------------------------------------------------

mkdir -p "$HOME/.local/bin"
ln -sf "$HYPOC_BIN" "$HYPOC_LINK"

SHELLS=()
[ -f "$HOME/.bash_profile" ] && SHELLS+=("$HOME/.bash_profile")
[ -f "$HOME/.bashrc" ] && SHELLS+=("$HOME/.bashrc")
[ -f "$HOME/.zshrc" ] && SHELLS+=("$HOME/.zshrc")
if [ ${#SHELLS[@]} -eq 0 ]; then
  SHELLS=("$HOME/.bash_profile")
fi
for rc in "${SHELLS[@]}"; do
  if ! grep -q 'export PATH.*\.local/bin' "$rc" 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$rc"
    say "added ~/.local/bin to PATH in $(basename "$rc")"
  fi
done
say "hypoc -> $HYPOC_LINK"

# --- 2. Ollama ----------------------------------------------------------------

if command -v ollama >/dev/null 2>&1 || [ -d "/Applications/Ollama.app" ]; then
  say "ollama: already installed"
else
  say "ollama: installing..."
  if [ "$(uname -s)" = "Darwin" ]; then
    if command -v brew >/dev/null 2>&1; then
      brew install --cask ollama
    else
      say "ERROR: Homebrew not found. Install Ollama from https://ollama.com and re-run."
      exit 1
    fi
  else
    curl -fsSL https://ollama.com/install.sh | sh
  fi
fi

# Ensure Ollama is serving so model pulls work.
if ! curl -sf --max-time 2 http://localhost:11434/api/tags >/dev/null 2>&1; then
  if [ "$(uname -s)" = "Darwin" ] && [ -d "/Applications/Ollama.app" ]; then
    open -a Ollama >/dev/null 2>&1 || true
  else
    nohup ollama serve >/dev/null 2>&1 &
  fi
  for _ in $(seq 1 20); do
    curl -sf --max-time 2 http://localhost:11434/api/tags >/dev/null 2>&1 && break
    sleep 0.5
  done
fi

# --- 3. Required models ---------------------------------------------------------

for model in "${REQUIRED_MODELS[@]}"; do
  # ollama lists untagged models with an implicit ":latest" suffix.
  if ollama list 2>/dev/null | awk '{print $1}' | grep -qxE "$model|$model:latest"; then
    say "model $model: present"
  else
    say "model $model: pulling (this can take a while)..."
    ollama pull "$model"
  fi
done

# --- 4. Qdrant (repo-local binary) ----------------------------------------------

mkdir -p "$QDRANT_DIR"
if [ -x "$QDRANT_DIR/qdrant" ] || command -v qdrant >/dev/null 2>&1; then
  say "qdrant: already installed"
else
  say "qdrant: downloading..."
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) asset="qdrant-aarch64-apple-darwin.tar.gz" ;;
    Darwin-x86_64) asset="qdrant-x86_64-apple-darwin.tar.gz" ;;
    Linux-x86_64) asset="qdrant-x86_64-unknown-linux-gnu.tar.gz" ;;
    Linux-aarch64) asset="qdrant-aarch64-unknown-linux-musl.tar.gz" ;;
    *) say "ERROR: unsupported platform $(uname -s)-$(uname -m) for qdrant auto-install"; exit 1 ;;
  esac
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/qdrant.tar.gz" "https://github.com/qdrant/qdrant/releases/latest/download/$asset"
  tar -xzf "$tmp/qdrant.tar.gz" -C "$QDRANT_DIR"
  chmod +x "$QDRANT_DIR/qdrant"
  rm -rf "$tmp"
  say "qdrant: installed to $QDRANT_DIR/qdrant"
fi

# The launcher's start script for the repo-local qdrant.
cat > "$QDRANT_DIR/run-qdrant.sh" <<'EOF'
#!/bin/bash
cd "$(dirname "$0")"
export QDRANT__STORAGE__STORAGE_PATH="./storage"
exec ./qdrant --disable-telemetry
EOF
chmod +x "$QDRANT_DIR/run-qdrant.sh"

# --- 5. Plugin dependencies (ecc-universal, superpowers) -----------------------
#
# .opencode.json's plugin array references these two packages, but until now no
# installer actually provisioned them - they were silently assumed to be
# pre-installed. This makes them real, pinned, managed dependencies. Pins live
# in versions.json (single source of truth), mirroring bmxoc's versions.json
# pattern, so bumping a version only means editing one file.
#
# Note: this only guarantees the packages are present on disk at a known
# version. Whether opencode's plugin-array loader actually picks them up on
# your installed opencode version is a separate, open upstream question (see
# versions.json's notes on superpowers) - not something this step can fix.

VERSIONS_FILE="$HYPOC_DIR/versions.json"

if [ -f "$VERSIONS_FILE" ] && command -v node >/dev/null 2>&1; then
  ECC_PINNED="$(node -pe "require('$VERSIONS_FILE').dependencies['ecc-universal'].pinned" 2>/dev/null || true)"
  SUPERPOWERS_TAG="$(node -pe "require('$VERSIONS_FILE').dependencies['superpowers'].pinnedTag" 2>/dev/null || true)"
  SUPERPOWERS_REPO="$(node -pe "require('$VERSIONS_FILE').dependencies['superpowers'].repo" 2>/dev/null || true)"
else
  say "WARNING: versions.json missing or node not found - skipping plugin dependency install"
  ECC_PINNED=""
  SUPERPOWERS_TAG=""
  SUPERPOWERS_REPO=""
fi

if [ -n "$ECC_PINNED" ]; then
  if command -v npm >/dev/null 2>&1; then
    installed_version="$(npm ls -g ecc-universal --depth=0 --json 2>/dev/null | node -pe "try { JSON.parse(require('fs').readFileSync(0,'utf-8')).dependencies['ecc-universal'].version } catch { '' }" 2>/dev/null || true)"
    if [ "$installed_version" = "$ECC_PINNED" ]; then
      say "ecc-universal: already at pinned version $ECC_PINNED"
    else
      say "ecc-universal: installing $ECC_PINNED (found: ${installed_version:-none})..."
      npm install -g "ecc-universal@$ECC_PINNED"
    fi
  else
    say "WARNING: npm not found - cannot install ecc-universal@$ECC_PINNED"
  fi
fi

if [ -n "$SUPERPOWERS_TAG" ] && [ -n "$SUPERPOWERS_REPO" ]; then
  SUPERPOWERS_DIR="$HOME/.cache/opencode/node_modules/superpowers"
  mkdir -p "$(dirname "$SUPERPOWERS_DIR")"
  if [ -d "$SUPERPOWERS_DIR/.git" ]; then
    current_tag="$(git -C "$SUPERPOWERS_DIR" describe --tags --exact-match 2>/dev/null || true)"
    if [ "$current_tag" = "$SUPERPOWERS_TAG" ]; then
      say "superpowers: already at pinned tag $SUPERPOWERS_TAG"
    else
      say "superpowers: updating to $SUPERPOWERS_TAG (found: ${current_tag:-unknown})..."
      git -C "$SUPERPOWERS_DIR" fetch --depth 1 origin "tag" "$SUPERPOWERS_TAG"
      git -C "$SUPERPOWERS_DIR" checkout "$SUPERPOWERS_TAG"
    fi
  else
    say "superpowers: cloning $SUPERPOWERS_TAG..."
    rm -rf "$SUPERPOWERS_DIR"
    git clone --depth 1 --branch "$SUPERPOWERS_TAG" "$SUPERPOWERS_REPO" "$SUPERPOWERS_DIR"
  fi
fi

# --- 6. Done --------------------------------------------------------------------

say "done. Open a new shell (or source your rc) and run: hypoc"
